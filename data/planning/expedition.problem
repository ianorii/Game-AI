    (ready_loadout fire_staff armor_leather n2)
    (ready_loadout fire_staff armor_leather n3)
    (ready_loadout weapon_axe armor_iron n1)
    (ready_loadout weapon_axe armor_iron n2)
    (ready_loadout weapon_axe armor_iron n3)

    ;; Ladang Kosong Siap Tanam
