(define (problem expedition-starter)
  (:domain dungeon-expedition)

  (:objects
    spawn shop workshop bed farm gate chicken_coop cow_pasture river_fishing forest_wood quarry_rock boss - location
    plot0 plot1 - plot
    n0 n1 n2 n3 - count
    sword_basic weapon_dagger weapon_axe fire_staff cloth_armor armor_leather armor_iron - item
    c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 c16 c17 c18 c19 c20 c21 c22 c23 c24 c25 c26 c27 c28 c29 c30 c31 c32 c33 c34 c35 c36 c37 c38 c39 c40 c41 c42 c43 c44 c45 c46 c47 c48 c49 c50 c51 c52 c53 c54 c55 c56 c57 c58 c59 c60 - coin
