    (hp_full)
    (gate_locked)
    (has sword_basic)
    (has cloth_armor)
    (equipped_weapon sword_basic)
    (equipped_armor cloth_armor)
    (equipped_ok)
    (coins c20)
    (has_n potion n0)

    ;; Valid CSP Loadouts
    (valid_loadout sword_basic cloth_armor)
    (valid_loadout weapon_dagger armor_leather)
    (valid_loadout weapon_axe armor_iron)
    (valid_loadout fire_staff armor_leather)

    ;; Ready Loadouts dari readiness.json (hero win rate >= 50%)
